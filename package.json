{
  "name": "@guyun/jsmodbus",
  "version": "4.1.0",
  "description": "Implementation for the Serial/TCP Modbus protocol.",
  "author": "Stefan Poeter <stefan.poeter@cloud-automation.de>",
  "main": "./dist/src/modbus.js",
  "types": "./dist/src/modbus.d.ts",
  "bin": {
    "jsmodbus": "./bin/jsmodbus.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gaofeng/node-modbus.git"
  },
  "engines": {
    "node": ">=6.0.0"
  },
  "dependencies": {
    "buffer": "^6.0.3",
    "crc": "4.3.2",
    "debug": "^4.4.0",
    "eventemitter3": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/debug": "^4.1.12",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.13.8",
    "@types/sinon": "^17.0.4",
    "serialport": "^13.0.0",
    "commander": "^13.1.0",
    "eslint": "^9.17.0",
    "mocha": "^11.1.0",
    "nyc": "^17.1.0",
    "prettier": "3.5.3",
    "sinon": "^20.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.65.0"
  },
  "scripts": {
    "test": "npm run lint && npm run build && npx mocha test/*.test.js",
    "build": "npx tsc",
    "lint": "pnpm eslint .",
    "watch": "npm run lint && npm run build && npx mocha --watch test/*.test.js",
    "prepublishOnly": "npm run test",
    "prepare": "npm run build",
    "cov": "nyc mocha test/*.test.js"
  },
  "license": "MIT",
  "keywords": [
    "client",
    "server",
    "serial",
    "port",
    "modbus",
    "tcp"
  ],
  "readmeFilename": "README.md",
  "directories": {
    "test": "test",
    "example": "examples"
  },
  "files": [
    "bin/**/*",
    "dist/**/*"
  ]
}
